[Unit]
Description=Power Guard battery safety daemon
Documentation=https://upower.freedesktop.org/
After=dbus.service upower.service
Wants=upower.service
StartLimitIntervalSec=30
StartLimitBurst=5

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/
EnvironmentFile=-/etc/default/power-guardian
Environment=POWER_SUSPEND_THRESHOLD=5
Environment=POWER_SHUTDOWN_THRESHOLD=3
Environment=POWER_POLL_INTERVAL=0
Environment=POWER_ACTION_COOLDOWN=2m
Environment=POWER_SUSPEND_RETRIES=3
Environment=POWER_SUSPEND_RETRY_DELAY=2s
Environment=POWER_SHUTDOWN_RETRIES=4
Environment=POWER_SHUTDOWN_RETRY_DELAY=1s
Environment=POWER_SHUTDOWN_SETTLE_DELAY=4s
Environment=POWER_EMERGENCY_POWEROFF=true
ExecStart=/usr/local/bin/go-power-guardian
Restart=on-failure
RestartSec=5s
TimeoutStopSec=20s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ProtectControlGroups=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictSUIDSGID=true
RestrictRealtime=true

[Install]
WantedBy=multi-user.target
